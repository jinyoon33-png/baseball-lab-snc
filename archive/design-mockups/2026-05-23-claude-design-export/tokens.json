{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$metadata": {
    "tokenSetOrder": ["light", "dark", "scale", "type", "shape", "doc"]
  },
  "name": "baseball-lab-clinical-trust",
  "version": "0.1.0",
  "description": "Clinical Trust direction — shared by interactive app (index.html) and 7 document pages.",
  "exportedAt": "2026-05-23",
  "exportedFrom": "Claude Design — Direction B",

  "color": {
    "bg":          { "$value": "#F5F6F8", "$type": "color", "$description": "App canvas background — cool neutral." },
    "surface":     { "$value": "#FFFFFF", "$type": "color", "$description": "Card / modal surface." },
    "surface-2":   { "$value": "#FAFBFC", "$type": "color", "$description": "Modal footer, subdued surface." },
    "tint":        { "$value": "#F0F4FA", "$type": "color", "$description": "Information / note backgrounds." },

    "ink":         { "$value": "#0F172A", "$type": "color", "$description": "Primary text. Also primary button bg." },
    "ink-2":       { "$value": "#1E293B", "$type": "color", "$description": "Secondary text." },
    "mute":        { "$value": "#64748B", "$type": "color", "$description": "Tertiary / meta text." },
    "mute-2":      { "$value": "#94A3B8", "$type": "color", "$description": "Placeholder text." },

    "rule":        { "$value": "#E2E8F0", "$type": "color", "$description": "Default border." },
    "rule-2":      { "$value": "#CBD5E1", "$type": "color", "$description": "Form control border." },

    "navy":        { "$value": "#1F4585", "$type": "color", "$description": "Accent / link / focus." },
    "navy-2":      { "$value": "#1A3A72", "$type": "color", "$description": "Accent darker." },
    "navy-bg":     { "$value": "#E7EDF7", "$type": "color", "$description": "Accent tint background." }
  },

  "signal": {
    "safe":     { "$value": "#2F7A5F", "$type": "color", "$description": "정상 — ACWR 0.8–1.3." },
    "safe-bg":  { "$value": "#D8EBE1", "$type": "color" },
    "watch":    { "$value": "#A67635", "$type": "color", "$description": "주의 — ACWR 1.3–1.5." },
    "watch-bg": { "$value": "#F4E7CF", "$type": "color" },
    "risk":     { "$value": "#B85C52", "$type": "color", "$description": "초과 — ACWR 1.5+." },
    "risk-bg":  { "$value": "#F4D6D1", "$type": "color" }
  },

  "chart": {
    "series-1": { "$value": "#1F4585", "$type": "color", "$description": "ACWR / 구속 line." },
    "series-2": { "$value": "#2F7A5F", "$type": "color", "$description": "Safe zone." },
    "series-3": { "$value": "#A67635", "$type": "color", "$description": "Watch zone." },
    "series-4": { "$value": "#B85C52", "$type": "color", "$description": "Risk zone." },
    "series-5": { "$value": "#64748B", "$type": "color", "$description": "Reference / muted." },
    "grid":     { "$value": "#E2E8F0", "$type": "color" }
  },

  "type": {
    "family-sans": { "$value": "Pretendard, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif", "$type": "fontFamily" },
    "family-mono": { "$value": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "$type": "fontFamily" },

    "display": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 700, "fontSize": "44px", "lineHeight": 1.05, "letterSpacing": "-0.025em" },
      "$description": "Hero / landing H1."
    },
    "h1-page": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 700, "fontSize": "36px", "lineHeight": 1.05, "letterSpacing": "-0.025em" }
    },
    "h2-card": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 700, "fontSize": "20px", "lineHeight": 1.2, "letterSpacing": "-0.02em" }
    },
    "h3-section": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 700, "fontSize": "15.5px", "lineHeight": 1.3, "letterSpacing": "-0.01em" }
    },
    "body": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 500, "fontSize": "13.5px", "lineHeight": 1.55, "letterSpacing": "-0.005em" }
    },
    "caption": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-sans}", "fontWeight": 500, "fontSize": "11.5px", "lineHeight": 1.5 }
    },
    "mono-stat": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-mono}", "fontWeight": 600, "fontSize": "36px", "lineHeight": 1, "letterSpacing": "-0.03em" }
    },
    "mono-num": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-mono}", "fontWeight": 600, "fontSize": "14px", "lineHeight": 1.2 }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": { "fontFamily": "{type.family-mono}", "fontWeight": 600, "fontSize": "10px", "letterSpacing": "0.18em", "textTransform": "uppercase" }
    }
  },

  "space": {
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "5":  { "$value": "20px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "3px",   "$type": "dimension" },
    "md":   { "$value": "4px",   "$type": "dimension" },
    "lg":   { "$value": "6px",   "$type": "dimension" },
    "xl":   { "$value": "8px",   "$type": "dimension" },
    "2xl":  { "$value": "14px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },

  "shadow": {
    "card":   { "$value": "0 1px 0 rgba(15, 23, 42, 0.04)", "$type": "shadow" },
    "modal":  { "$value": "0 30px 90px rgba(15, 23, 42, 0.25)", "$type": "shadow" },
    "sheet":  { "$value": "0 -20px 60px rgba(15, 23, 42, 0.2)", "$type": "shadow" },
    "focus":  { "$value": "0 0 0 3px rgba(15, 23, 42, 0.06)", "$type": "shadow" }
  },

  "doc": {
    "$description": "Document pages (about, *-guide, contact, privacy, terms) — shared master layout.",
    "max-width":     { "$value": "720px", "$type": "dimension" },
    "body-size":     { "$value": "16px",  "$type": "dimension" },
    "body-leading":  { "$value": "1.7",   "$type": "number" },
    "h1-size":       { "$value": "40px",  "$type": "dimension" },
    "h2-size":       { "$value": "22px",  "$type": "dimension" },
    "h3-size":       { "$value": "15.5px","$type": "dimension" },
    "section-gap":   { "$value": "40px",  "$type": "dimension" },
    "p-gap":         { "$value": "14px",  "$type": "dimension" }
  },

  "darkMode": {
    "$description": "Dark mode override set — apply to [data-theme='dark'] or .dark.",
    "bg":         { "$value": "#0F1419", "$type": "color" },
    "surface":    { "$value": "#1A1F26", "$type": "color" },
    "surface-2":  { "$value": "#171B22", "$type": "color" },
    "tint":       { "$value": "#1F2530", "$type": "color" },
    "ink":        { "$value": "#E8ECF4", "$type": "color" },
    "ink-2":      { "$value": "#C8CED9", "$type": "color" },
    "mute":       { "$value": "#8A95A4", "$type": "color" },
    "rule":       { "$value": "#2A2F38", "$type": "color" },
    "rule-2":     { "$value": "#3A4150", "$type": "color" },
    "navy":       { "$value": "#6B9DE8", "$type": "color" },
    "navy-bg":    { "$value": "rgba(107, 157, 232, 0.14)", "$type": "color" },
    "safe":       { "$value": "#6BAF8A", "$type": "color" },
    "safe-bg":    { "$value": "rgba(107, 175, 138, 0.16)", "$type": "color" },
    "watch":      { "$value": "#D9A75C", "$type": "color" },
    "watch-bg":   { "$value": "rgba(217, 167, 92, 0.16)", "$type": "color" },
    "risk":       { "$value": "#E88B7E", "$type": "color" },
    "risk-bg":    { "$value": "rgba(232, 139, 126, 0.18)", "$type": "color" }
  },

  "componentMap": {
    "$description": "Component class name → CSS file location (see components.css).",
    "Button":         { "primary": ".btn.btn-primary", "accent": ".btn.btn-navy", "outline": ".btn.btn-outline", "ghost": ".btn.btn-ghost", "sizes": [".btn-sm", ".btn-lg", ".btn-block"] },
    "Card":           ".card",
    "Modal":          ".modal · .modal-head · .modal-body · .modal-foot · .modal-scrim",
    "Form":           { "field": ".field", "label": ".label", "input": ".input", "select": ".select", "toggle": ".toggle", "range": ".range" },
    "Player":         ".player-row · .player-name · .player-tag · .player-meta · .player-avatar",
    "Badge":          ".badge.{safe|watch|risk|muted}",
    "Chip":           ".chip · .chip[aria-pressed='true']",
    "Stat":           ".stat-label · .stat-val · .stat-unit",
    "Eyebrow":        ".eyebrow",
    "ACWR Hero":      ".hero-data",
    "RPE strip":      ".rpe-bar · .rpe-cell[data-zone='easy|moderate|hard|max']",
    "Schedule":       ".week-list · .week-row · .week-row.today · .week-item",
    "Assessment":     ".assess-card · .assess-input · .assess-bar",
    "Doc page":       ".doc-wrap · .doc-h1 · .doc-body · .doc-note · .doc-warn · .doc-danger · .doc-table",
    "Tabbar":         ".tabbar · .tab",
    "Topbar":         ".topbar · .brand · .nav · .nav button[aria-current]"
  }
}
